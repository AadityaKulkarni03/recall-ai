# ── Required ─────────────────────────────────────────────────────
MOSS_PROJECT_ID=your_moss_project_id          # From https://moss.dev dashboard
MOSS_PROJECT_KEY=your_moss_project_key        # From https://moss.dev dashboard
GROQ_API_KEY=your_groq_api_key               # From https://console.groq.com

# ── Optional ─────────────────────────────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key        # From https://console.deepgram.com (required for live audio only)
GROQ_LLM_MODEL=openai/gpt-oss-20b            # LLM model for RAG generation
GROQ_STT_MODEL=whisper-large-v3-turbo         # STT model for audio file transcription
MOSS_SESSION_NAME=recall-session              # Moss session identifier
TOP_K=5                                       # Number of passages to retrieve per query

# ── Deployment ───────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-frontend.vercel.app   # Comma-separated allowed CORS origins
